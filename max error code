"""
Вычисление максимальной ошибки (max error) без переобучения.
"""

import numpy as np
import torch
import joblib
import sys

# Добавляем текущую папку в пути для импорта (на случай, если скрипт не видит calibration_experiments)
sys.path.append('.')

try:
 from calibration_experiments import generate_synthetic_data, CalibrationMLP
except ImportError:
 print("Ошибка: не удалось импортировать generate_synthetic_data из calibration_experiments.py")
 print("Убедитесь, что файл calibration_experiments.py находится в той же папке")
 sys.exit(1)

print("=" * 50)
print("Вычисление максимальной ошибки (max error) MLP на новых данных")
print("=" * 50)

# 1. Загрузка модели
print("\n1. Загрузка модели...")
try:
 model = CalibrationMLP()
 model.load_state_dict(torch.load('best_model.pth', map_location='cpu'))
 model.eval()
 print(" Модель загружена успешно")
except Exception as e:
 print(f" Ошибка загрузки модели: {e}")
 sys.exit(1)

# 2. Загрузка scaler'ов
print("\n2. Загрузка нормализаторов...")
try:
 scaler_X = joblib.load('scaler_X.pkl')
 scaler_y = joblib.load('scaler_y.pkl')
 print(" Scaler'ы загружены успешно")
except Exception as e:
 print(f" Ошибка загрузки scaler'ов: {e}")
 sys.exit(1)

# 3. Генерация новых данных (50 000 отсчётов, новый random seed)
print("\n3. Генерация новых данных (seed=123)...")
np.random.seed(42) # новый seed, отличный от обучения (был 42)
X_raw, y_true = generate_synthetic_data(50000)
print(f" Данные сгенерированы: X {X_raw.shape}, y {y_true.shape}")

# 4. Нормализация
print("\n4. Нормализация данных...")
X_norm = scaler_X.transform(X_raw)
print(f" X нормализован: диапазон [{X_norm.min():.2f}, {X_norm.max():.2f}]")

# 5. Применение модели
print("\n5. Применение модели MLP...")
X_tensor = torch.tensor(X_norm, dtype=torch.float32)
with torch.no_grad():
 y_pred_norm = model(X_tensor).numpy()
y_pred = scaler_y.inverse_transform(y_pred_norm)

# 6. Расчёт ошибок
errors = np.abs(y_true - y_pred)
max_error = np.max(errors)
mean_error = np.mean(errors)
rmse = np.sqrt(np.mean((y_true - y_pred)**2))

print("\n" + "=" * 50)
print("РЕЗУЛЬТАТЫ НА НОВЫХ ДАННЫХ (seed=123)")
print("=" * 50)
print(f"Максимальная абсолютная ошибка (max error): {max_error:.4f} g")
print(f"Средняя абсолютная ошибка (MAE): {mean_error:.4f} g")
print(f"Среднеквадратичная ошибка (RMSE): {rmse:.4f} g")
print(f"Относительная ошибка (RMSE / 2g): {rmse/2*100:.2f}%")
print("=" * 50)
