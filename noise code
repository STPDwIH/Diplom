"""
Тест устойчивости к шуму (без переобучения)
"""
import numpy as np
import torch
import joblib
from sklearn.model_selection import train_test_split
from calibration_experiments import generate_synthetic_data, CalibrationMLP, compute_metrics, relative_error

# Загрузка уже обученной модели
print("Загрузка модели...")
model = CalibrationMLP()
model.load_state_dict(torch.load('best_model.pth', map_location='cpu'))
model.eval()

# Загрузка нормализаторов
scaler_X = joblib.load('scaler_X.pkl')
scaler_y = joblib.load('scaler_y.pkl')
print("Готово\n")

# Параметры
num_samples = 50000
fs = 100.0

# Уровни шума
noise_levels = {
 "0% (номинал)": 100e-6,
 "+20%": 120e-6,
 "+50%": 150e-6,
 "+100%": 200e-6
}

print("Анализ устойчивости к шуму (без переобучения)")
print("=" * 70)
print(f"{'Уровень шума':<20} {'RMSE, g':<15} {'Отн. погрешность, %':<20}")
print("-" * 70)

for name, noise_density in noise_levels.items():
 # Генерация НОВЫХ данных с другим уровнем шума
 X_raw, y_true = generate_synthetic_data(num_samples, fs, noise_density=noise_density)
 
 # Берём только тестовую часть (15%)
 _, X_test, _, y_test = train_test_split(X_raw, y_true, test_size=0.15, random_state=42)
 
 # Нормализация
 X_test_norm = scaler_X.transform(X_test)
 
 # Применение модели (без обучения!)
 X_tensor = torch.tensor(X_test_norm, dtype=torch.float32)
 with torch.no_grad():
 y_pred_norm = model(X_tensor).numpy()
 y_pred = scaler_y.inverse_transform(y_pred_norm)
 
 # Расчёт RMSE
 rmse, _, _, _ = compute_metrics(y_test, y_pred)
 rel_err = relative_error(rmse)
 
 print(f"{name:<20} {rmse:<15.4f} {rel_err:<20.2f}")

print("=" * 70)
